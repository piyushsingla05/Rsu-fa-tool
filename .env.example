# Production environment template - VARIABLE NAMES ONLY, no real values.
#
# Copy this to a file OUTSIDE this git repository (e.g.
# /etc/workbench/workbench.env), fill in real values there, set it to mode
# 600 owned by the service account, and point the systemd unit's
# EnvironmentFile= at it. NEVER commit a filled-in copy of this file.
#
# See deploy/RUNBOOK.md for how each of these is used and why both of the
# first two must be pinned (not left unset) in production.

# Required. The single shared password preparers sign in with. Unset, the
# app auto-generates one and prints it once to stdout - fine for an
# interactive dev session, unacceptable for a service running headless
# under a supervisor where nobody will see that line.
APP_PASSWORD=

# Required. Signs session tokens (HMAC). Unset, a random one is generated
# in the process's own memory at startup, which means EVERY restart
# force-logs-out every signed-in session. Pin this so restarts (deploys,
# crashes, reboots) don't repeatedly log everyone out.
APP_SECRET=

# Optional. Cosmetic only - the name shown in the browser tab and sidebar.
# Defaults to "Workbench" if unset.
APP_NAME=
